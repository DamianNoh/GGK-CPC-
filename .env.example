# 중요: cpc-dashboard-app(실데이터 대시보드) 프로젝트와 반드시 "동일한" 연결 문자열을 넣어야 합니다.
# CPC 금액 데이터(Workcenter, CpcEntry)를 그 프로젝트와 공유해서 읽기 때문입니다.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 이 프로젝트만의 로그인 비밀번호 (실데이터 대시보드와 같은 값을 써도 되고 달라도 됩니다)
APP_PASSWORD="change-me"

# 세션 쿠키 서명용 임의의 긴 문자열 (openssl rand -hex 32 로 생성 권장, 실데이터 프로젝트와 달라도 무방)
SESSION_SECRET="change-me-too"
